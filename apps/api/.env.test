# Banco de teste local, separado do banco de desenvolvimento (paguessr).
# Carregado automaticamente pelos testes (Vitest define VITEST=true).
# Não tem segredo nenhum aqui, por isso este arquivo é versionado.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/paguessr_test
LOG_LEVEL=silent
# Rotas de login/recuperação de senha são rate-limited (ver authRoutes.ts). Os
# testes batem nelas várias vezes seguidas a partir do mesmo IP, então usamos
# um teto bem mais alto aqui do que o padrão de produção.
AUTH_RATE_LIMIT_MAX=1000
CHAMPIONSHIPS_MODE=public
