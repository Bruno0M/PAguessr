# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paguessr
POSTGRES_PORT=5434

# Backend API
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5434/paguessr
NODE_ENV=development

# Frontend Web
WEB_PORT=3000
VITE_API_URL=http://localhost:3333

# Google Maps / Street View API (opcional na v1 com mock)
GOOGLE_STREET_VIEW_API_KEY=

# Street View Panorama (360° interativo)
STREETVIEW_PANORAMA_ENABLED=false
STREETVIEW_PANORAMA_MONTHLY_BUDGET=4500

# Teto diário de buscas estáticas do Street View (todo mundo, somado)
STREETVIEW_STATIC_DAILY_BUDGET=320

# Limites de uso (proteção da cota do Google e do ranking)
GAMES_PER_HOUR_MAX=30
REGISTER_RATE_LIMIT_MAX=5

# Chave pública para o Dynamic Street View no navegador (deve ser criada manualmente no GCP Console restrita por HTTP referrer/domínio)
GOOGLE_MAPS_BROWSER_KEY=

# Lista de nicks com permissão de administrador separados por vírgula
ADMIN_NICKS=

# Modo do recurso de campeonatos: off (ninguém vê, nem admin), admin (apenas nicks em ADMIN_NICKS), public (todos)
CHAMPIONSHIPS_MODE=public

# Umami Analytics (script embutido no index.html no build)
VITE_UMAMI_SCRIPT_URL=https://analytics.ollim.dev/script.js
VITE_UMAMI_WEBSITE_ID=
